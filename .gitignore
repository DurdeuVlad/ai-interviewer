# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# uv lockfiles should be committed for reproducible installs
# (overrides a global *.lock ignore some machines have configured)
!**/uv.lock

# Env / secrets
.env
!.env.example

# SQLite runtime DB
*.db
*.db-journal

# Exports (user-generated transcripts, not repo content)
backend/exports/*
!backend/exports/.gitkeep

# Node / frontend
node_modules/
dist/

# OS
.DS_Store
Thumbs.db
