LLM_PROVIDER=mock
# gemini | openai | mock  (claude dropped for now, see docs/decisions.md)

DEBUG_MODE=false
# true: CLI prints each turn's checklist state + the model's one-line reasoning

TYPING_DELAY_SECONDS=0.015
# per-character delay while streaming question text to the terminal; 0 to disable

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

DATABASE_PATH=./interviews.db
CORS_ORIGIN=http://localhost:5173
